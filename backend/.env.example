# Host del servidor MySQL o MariaDB
DB_HOST=localhost

# Puerto del servidor MySQL o MariaDB
DB_PORT=3306

# Usuario de conexión a MySQL
DB_USER=root

# Contraseña de MySQL (con XAMPP por defecto root no tiene contraseña)
DB_PASSWORD=

# Nombre de la base de datos
DB_NAME=db_DanielNarvaez2

# Clave secreta para firmar tokens JWT. Debe cambiarse por un valor largo y aleatorio.
JWT_SECRET=danielnarvaezlopez

# Tiempo de expiración de los tokens JWT en minutos
JWT_EXPIRE_MINUTES=60